# =============================================================================
# taleTribe-recs — standalone recommendation service.
#
# Run it with:
#   poetry install
#   (from repos/story-data)  docker compose up -d postgres && make migrate
#   python -m recommendation_engine.server        # :8100
# =============================================================================

# Postgres + pgvector (>= 0.8.0 required for hnsw.iterative_scan). The
# `recommendations` schema lives in story-data's database and is migrated by
# story-data; this service only reads and writes that schema. The default below
# is story-data's local stack, so local dev needs no config at all — and
# ENVIRONMENT=production refuses to start on it.
# RECS_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/story_data
# Read-only DSN for request serving. Blank = reuse RECS_DATABASE_URL (correct
# locally, one compute). In production this points at a dedicated read-only
# compute so vector scans never share compute with the billing workload.
# RECS_DATABASE_URL_RO=
# RECS_DB_POOL_MIN=1
# RECS_DB_POOL_MAX=10

# Separate variable used ONLY by tests, which write and delete rows. Unset means
# the integration tests skip themselves (which is how CI stays green).
# RECS_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/story_data

# Service port.
# PORT=8100

# development | production. Unset = development, which is what makes local
# dev work with no OIDC credentials and no Firestore project.
# ENVIRONMENT=development

# OIDC audience for Firebase Functions -> recommendations calls. REQUIRED in
# production; unset outside it, which is what makes local dev credential-free.
# RECS_SERVICE_URL=https://taletribe-recs-xxxx.run.app
# FIREBASE_FUNCTIONS_SERVICE_ACCOUNT=story-6f89f@appspot.gserviceaccount.com
# ALLOWED_SERVICE_ACCOUNTS=story-6f89f@appspot.gserviceaccount.com

# Required only if/when the Firestore signals sync (Phase 3) is wired up.
# GOOGLE_CLOUD_PROJECT=story-6f89f
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Browser origins allowed to call this service directly, if any (JSON array).
# CORS_ORIGINS=["http://localhost:5173"]

# Gemini, called DIRECTLY (not via creditProxy) so explanations can stream token
# by token and be cancelled mid-generation. Consequence: explanations are not
# credit-metered, so the deterministic cache and the LLM rate bucket below are
# the only cost controls.
# GOOGLE_AI_STUDIO_API_KEY=...
# RECS_GEMINI_MODEL=gemini-2.5-flash-lite
# RECS_EXPLANATION_MAX_OUTPUT_TOKENS=256
# RECS_HYDE_MAX_OUTPUT_TOKENS=512

# Two rate buckets. Ranking is one DB round trip and can be generous; the second
# guards the paths that spend tokens (HyDE, explanations).
# MAX_REQUESTS_PER_MINUTE_PER_USER=30
# MAX_LLM_REQUESTS_PER_MINUTE_PER_USER=6

# Retrieval knobs. ef_search must stay >= 2x RECS_CANDIDATE_POOL or HNSW recall
# degrades with no error anywhere (a warning is logged at startup). Re-run the
# eval sweep before changing these.
# RECS_HNSW_EF_SEARCH=100
# RECS_HNSW_MAX_SCAN_TUPLES=20000
# RECS_STATEMENT_TIMEOUT_MS=2000
# RECS_CANDIDATE_POOL=50
# RECS_DEFAULT_TOP_K=10

# Feature flags.
# RECS_ENABLE_HYDE=true
# RECS_ENABLE_EXPLANATIONS=true

# Set USE_MOCK=true to run with deterministic offline embeddings. Good for tests
# and plumbing; useless for judging recommendation quality, because the mock
# embedder is md5-seeded and carries no semantics.
# USE_MOCK=true
